# Copy to .env and fill in values from the Supabase project Connect panel.
# Expo requires the EXPO_PUBLIC_ prefix for client-side variables.
# Do not put SUPABASE_SECRET_KEY or SUPABASE_DB_URL here — those are server-only.

EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
